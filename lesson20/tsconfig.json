{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "./build",
        "rootDir": ".",
        "declaration": true,
        "resolveJsonModule": true
    },
    "include": [
        "worlds/**/*.ts",
        "hooks/**/*.ts",
        "step_definitions/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}